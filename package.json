{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "npm run lighthouse:mobile && npm run lighthouse:desktop",
    "lighthouse:mobile": "lhci autorun",
    "lighthouse:desktop": "cross-env LH_FORM_FACTOR=desktop lhci autorun",
    "check:files": "node scripts/check-file-sizes.mjs",
    "check": "npm run check:files && npm run typecheck && npm run test && npm run build && npm run test:e2e && npm run lighthouse",
    "optimize:models": "node scripts/optimize-models.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "@astrojs/vue": "^7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@gltf-transform/cli": "^4.5.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.186.0",
    "chrome-launcher": "^0.13.4",
    "cross-env": "^10.1.0",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "private": true
}
