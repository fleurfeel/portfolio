---
// «Услуги и стоимость»: список строк на фоне сайта. Слева название, в центре теги и описание, справа срок, цена и кнопка заявки.
// Появление по скроллу (CSS scroll-driven, у каждой строки своя view-timeline): линия прочерчивается слева направо,
// слова названия переворачиваются, как в манифесте, теги раздаются веером из одной точки, остальное всплывает.
// При наведении на строку: линия становится фиолетовой, название сдвигается, теги по очереди становятся фиолетовыми,
// кнопка заливается и надпись прокатывается. Меняются только transform и opacity.
// Кнопка «Оставить заявку» открывает форму (остров LeadForm.vue), услуга в ней уже выбрана.
// Ноутбук и десктоп (≥ 1024): три колонки. Планшет (640–1023): описание и цена рядом. Телефон: всё в один столбец.
// Без поддержки scroll-driven animations или при reduced motion — всё сразу на местах.
import { services } from '../../data/services';
import LeadForm from './LeadForm.vue';

const titleWords = 'Услуги и стоимость'.split(' ');
---

<section class="services" id="services" aria-labelledby="services-title">
  <div class="services__head">
    <h2 id="services-title" class="services__title">
      {
        titleWords.map((word, i) => (
          <>
            <span class="services__word" style={`--s:${i}`}>
              {word}
            </span>{' '}
          </>
        ))
      }
    </h2>
    <p class="services__lead">Цена зависит от числа экранов и сложности логики. Точную сумму называю после брифа, и дальше она не растёт без вашего согласия.</p>
  </div>

  <ul class="services__list">
    {
      services.map((service, i) => (
        <li class="services__row">
          <span class="services__line" aria-hidden="true" />
          <div class="services__name-wrap">
            <span class="services__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="services__name">
              {service.title.split(' ').map((word, w) => (
                <>
                  <span class="services__word" style={`--s:${w + 1}`}>
                    {word}
                  </span>{' '}
                </>
              ))}
            </h3>
          </div>
          <ul class="services__tags">
            {service.tags.map((tag, t) => (
              <li class="services__tag" style={`--t:${t}`}>
                <span>{tag}</span>
              </li>
            ))}
          </ul>
          <p class="services__text">{service.text}</p>
          <div class="services__side">
            <p class="services__term">Срок: {service.term}</p>
            <p class="services__price">{service.price}</p>
            <button class="services__cta" type="button" data-lead={service.title}>
              <span class="services__cta-roll">
                <span>Оставить заявку</span>
                <span aria-hidden="true">Оставить заявку</span>
              </span>
            </button>
          </div>
        </li>
      ))
    }
  </ul>

  <LeadForm client:idle services={services.map((s) => s.title)} />
</section>

<style>
  .services {
    position: relative;
    z-index: 2; /* над фиксированным 3D-холстом */
    overflow-x: clip;
    color: var(--color-text);
  }

  .services__title {
    font-weight: var(--font-weight-heading);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    perspective: 800px;
  }

  .services__word {
    display: inline-block;
    transform-origin: 50% 100%;
  }

  .services__lead {
    font-size: var(--text-fs);
    line-height: 1.3;
    color: var(--color-secondary);
  }

  .services__row {
    position: relative;
    display: grid;
  }

  .services__line,
  .services__line::after {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 1px;
    transform-origin: 0 50%;
  }

  .services__line {
    background: color-mix(in srgb, var(--color-text) 18%, transparent);
  }

  /* при наведении линия прочерчивается фиолетовым поверх серой */
  .services__line::after {
    content: '';
    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .services__name-wrap {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .services__num {
    flex: none;
    color: var(--color-secondary);
    font-size: var(--small-fs);
    font-weight: var(--font-weight-text);
    line-height: 1.2;
  }

  .services__name {
    font-size: var(--name-fs);
    font-weight: var(--font-weight-heading);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    perspective: 800px;
    transition: translate 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .services__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .services__tag {
    position: relative;
    overflow: hidden;
    padding: 8px 16px;
    border-radius: 60px;
    background: var(--color-text);
    color: var(--color-surface);
    font-size: var(--small-fs);
    font-weight: var(--font-weight-text);
    line-height: 1.2;
  }

  .services__tag::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    opacity: 0;
    transition: opacity 0.35s ease calc(var(--t) * 50ms);
  }

  .services__tag span {
    position: relative;
  }

  .services__text {
    font-size: var(--text-fs);
    line-height: 1.3;
  }

  .services__term {
    color: var(--color-secondary);
    font-size: var(--text-fs);
    line-height: 1.2;
  }

  .services__price {
    margin-top: 4px;
    font-size: var(--price-fs);
    font-weight: var(--font-weight-heading);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .services__cta {
    position: relative;
    overflow: hidden;
    width: 100%;
    margin-top: 16px;
    padding: 14px 16px;
    border: 1px solid var(--color-text);
    white-space: nowrap;
    border-radius: 42px;
    color: var(--color-text);
    font: inherit;
    font-size: var(--cta-fs);
    font-weight: var(--font-weight-text);
    line-height: 1.2;
    cursor: pointer;
  }

  /* заливка въезжает слева */
  .services__cta::before {
    content: '';
    position: absolute;
    inset: -1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* надпись в два слоя: тёмная уезжает вверх, белая приходит снизу */
  .services__cta-roll {
    position: relative;
    display: block;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .services__cta-roll > span {
    display: block;
  }

  .services__cta-roll > span + span {
    position: absolute;
    top: calc(100% + 16px);
    right: 0;
    left: 0;
    color: var(--color-surface);
  }

  .services__cta:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .services__row:hover .services__line::after {
      transform: none;
    }

    .services__row:hover .services__name {
      translate: 16px 0;
    }

    .services__row:hover .services__tag::before {
      opacity: 1;
    }

    .services__cta:hover::before {
      transform: none;
    }

    .services__cta:hover .services__cta-roll {
      transform: translateY(calc(-100% - 16px));
    }
  }

  /* ---------- телефон (< 640): всё в один столбец ---------- */
  @media (max-width: 1023.98px) {
    .services {
      --pad-x: 20px;
      --name-fs: 30px;
      --text-fs: 17px;
      --small-fs: 14px;
      --price-fs: 28px;
      --cta-fs: 16px;

      padding: 80px var(--pad-x);
    }

    .services__head {
      display: grid;
      gap: 16px;
      margin-bottom: 40px;
    }

    .services__title {
      font-size: 32px;
    }

    .services__row {
      gap: 20px;
      padding-block: 28px 36px;
    }

    .services__side {
      margin-top: 4px;
    }
  }

  /* ---------- планшет (640–1023): описание и цена рядом ---------- */
  @media (min-width: 640px) and (max-width: 1023.98px) {
    .services {
      --pad-x: 40px;
      --name-fs: 36px;
    }

    .services__title {
      font-size: 44px;
    }

    .services__row {
      grid-template-columns: minmax(0, 1.5fr) minmax(220px, 1fr);
      grid-template-areas:
        'name name'
        'tags tags'
        'text side';
      column-gap: 40px;
    }

    .services__name-wrap {
      grid-area: name;
    }

    .services__tags {
      grid-area: tags;
    }

    .services__text {
      grid-area: text;
    }

    .services__side {
      grid-area: side;
      margin-top: 0;
    }
  }

  /* ---------- ноутбук и десктоп (≥ 1024): три колонки, размеры ноутбучного макета × (ширина / 1440) ---------- */
  @media (min-width: 1024px) {
    .services {
      --k: calc(100vw / 1440);
      --pad-x: calc(60 * var(--k));
      --pad-top: calc(120 * var(--k));
      --title-fs: calc(58 * var(--k));
      --name-fs: calc(44 * var(--k));
      --text-fs: 18px;
      --small-fs: 15px;
      --price-fs: max(24px, calc(30 * var(--k)));
      --cta-fs: 16px;
      --cols: minmax(0, 1fr) minmax(0, 0.66fr) minmax(240px, 0.34fr);
      --col-gap: calc(32 * var(--k));

      padding: calc(var(--pad-top) * 0.5) var(--pad-x) var(--pad-top);
    }

    .services__head {
      display: grid;
      grid-template-columns: var(--cols);
      column-gap: var(--col-gap);
      align-items: end;
      margin-bottom: calc(64 * var(--k));
    }

    .services__title {
      font-size: var(--title-fs);
    }

    .services__lead {
      grid-column: 2 / 4;
      max-width: 34em;
    }

    .services__row {
      grid-template-columns: var(--cols);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'name tags tags'
        'name text side';
      column-gap: var(--col-gap);
      row-gap: calc(72 * var(--k));
      padding-block: calc(36 * var(--k));
    }

    .services__name-wrap {
      grid-area: name;
    }

    .services__tags {
      grid-area: tags;
      max-width: 620px;
    }

    .services__text {
      grid-area: text;
    }

    .services__side {
      grid-area: side;
    }
  }

  @media (min-width: 1920px) {
    .services {
      --k: calc(1920px / 1440);
      --pad-x: 55px;
      --pad-top: 112px;
      --title-fs: 64px;
      --text-fs: 20px;
      --small-fs: 16px;
    }
  }

  /* появление строки по скроллу. Таймлайн — через переменную: минификатор иначе ломает animation-timeline.
     cover 0% — верх строки у нижнего края экрана: всё успевает проиграть, пока строка на виду */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .services__head,
      .services__row {
        view-timeline-name: --services-row;
      }

      .services__line,
      .services__word,
      .services__tag,
      .services__text,
      .services__side,
      .services__lead,
      .services__num {
        --row-tl: --services-row;

        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: var(--row-tl);
      }

      .services__line {
        animation-name: services-line;
        animation-range: cover 0% cover 26%;
      }

      .services__num {
        animation-name: services-rise;
        animation-range: cover 2% cover 12%;
      }

      /* --s: номер слова */
      .services__word {
        animation-name: services-flip;
        animation-range: cover calc(2% + var(--s) * 3%) cover calc(16% + var(--s) * 3%);
      }

      /* --t: номер тега, следующий вылетает позже и из более дальней точки */
      .services__tag {
        animation-name: services-deal;
        animation-range: cover calc(6% + var(--t) * 2.5%) cover calc(20% + var(--t) * 2.5%);
      }

      .services__lead,
      .services__text {
        animation-name: services-rise;
        animation-range: cover 12% cover 26%;
      }

      .services__side {
        animation-name: services-rise;
        animation-range: cover 16% cover 30%;
      }
    }
  }

  @keyframes services-line {
    from {
      transform: scaleX(0);
    }

    to {
      transform: none;
    }
  }

  @keyframes services-flip {
    from {
      opacity: 0;
      transform: translateY(0.6em) rotateX(-95deg);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes services-deal {
    from {
      opacity: 0;
      transform: translateX(calc((var(--t) + 1) * -36px)) rotate(calc((var(--t) - 2) * 6deg)) scale(0.8);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes services-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services__line::after,
    .services__name,
    .services__tag::before,
    .services__cta::before,
    .services__cta-roll {
      transition: none;
    }
  }
</style>
