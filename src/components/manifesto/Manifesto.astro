---
// Манифест: голова маскота и крупная цитата. Макеты Figma: Mobile 393 (491:312), Laptop 1440 (491:253), Desktop 1920 (491:259).
// Слова «переворачиваются» и проявляются по мере того, как секция въезжает в экран, —
// чистый CSS (scroll-driven animations), без JS. Нет поддержки или reduced motion — текст сразу виден.
// Голова — постер: 3D-маскот из сцены перелетает сюда и остаётся одной головой (тело растворяется).
import { Image } from 'astro:assets';
import head from '../../assets/manifesto/head.png';

const text =
  'Мне важно не просто закрыть задачу и сдать макет. Я отношусь к чужому продукту так, будто он мой: стараюсь понять, что за ним стоит, и помочь ему стать сильнее, а не просто красивее.';
const words = text.split(' ');
---

<section class="manifesto" aria-label="Мой подход" data-manifesto>
  <div class="manifesto__head">
    <Image
      src={head}
      widths={[130, 200, 260, 400]}
      sizes="(min-width: 1920px) 200px, (min-width: 1024px) 133px, 130px"
      alt=""
      loading="lazy"
      decoding="async"
      data-mascot-poster="head"
    />
  </div>
  <p class="manifesto__text">
    {
      words.map((word, i) => (
        <>
          <span class="manifesto__word" style={`--s:${(i / words.length).toFixed(4)}`}>
            {word}
          </span>{' '}
        </>
      ))
    }
  </p>
</section>

<style>
  .manifesto {
    position: relative;
    z-index: 2; /* над фиксированным 3D-холстом: тело маскота уходит за текст */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    min-height: 100svh;
    padding: 80px 13px;
    color: var(--color-text);
    view-timeline-name: --manifesto;
  }

  .manifesto__head {
    width: 130px;
    transition: opacity 0.6s ease;
  }

  /* 3D готов — на месте постера будет 3D-голова */
  :global([data-stage][data-mascot='ready']) ~ .manifesto .manifesto__head {
    opacity: 0;
  }

  .manifesto__head :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .manifesto__text {
    max-width: 367px;
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.04em;
    text-align: center;
    perspective: 900px;
  }

  .manifesto__word {
    display: inline-block;
  }

  /* 1024–1440: ноутбучный макет × (ширина / 1440) */
  @media (min-width: 1024px) {
    .manifesto {
      padding-inline: calc(79.5 * 100vw / 1440);
    }

    .manifesto__head {
      width: calc(133 * 100vw / 1440);
    }

    .manifesto__text {
      max-width: none;
      font-size: calc(58 * 100vw / 1440);
    }
  }

  /* 1440–1920: плавно к десктопному */
  @media (min-width: 1440px) {
    .manifesto {
      padding-inline: calc(79.5px - 39.5 * (100vw - 1440px) / 480);
    }

    .manifesto__head {
      width: calc(133px + 67 * (100vw - 1440px) / 480);
    }

    .manifesto__text {
      font-size: calc(58px + 6 * (100vw - 1440px) / 480);
    }
  }

  @media (min-width: 1920px) {
    .manifesto {
      padding-inline: 40px;
    }

    .manifesto__head {
      width: 200px;
    }

    .manifesto__text {
      font-size: 64px;
    }
  }

  /* ---------- переворот слов при скролле ---------- */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .manifesto__head {
        animation: manifesto-rise linear both;
        animation-timeline: --manifesto;
        animation-range: entry 0% entry 35%;
      }

      /* каждое слово — свой отрезок въезда секции: волна от первого слова к последнему */
      .manifesto__word {
        transform-origin: 50% 100%;
        animation: manifesto-flip linear both;
        animation-timeline: --manifesto;
        animation-range: entry calc(15% + var(--s) * 55%) entry calc(30% + var(--s) * 55%);
      }
    }
  }

  @keyframes manifesto-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @keyframes manifesto-flip {
    from {
      opacity: 0;
      transform: translateY(0.35em) rotateX(-90deg);
    }
  }
</style>
