---
// Манифест: голова маскота и крупная цитата. Макеты Figma: Mobile 393 (491:312), Laptop 1440 (491:253), Desktop 1920 (491:259).
// Слова «переворачиваются» волной, когда секция поднялась примерно на треть экрана: проигрыш по времени,
// не по скроллу, — иначе при прокрутке колесом эффект проскакивает незаметно. Включает и запускает
// остров Stage.vue (атрибут data-reveal: '' — ждём, 'in' — играем). Без JS и при reduced motion текст виден сразу.
// Голова — постер: 3D-маскот из сцены перелетает сюда и остаётся одной головой (тело растворяется).
// Дальше голова летит вниз, в «Как я работаю», и раздвигает строки: слова с data-part пружинят в стороны
// (свойства translate и rotate ставит Stage.vue).
import { Image } from 'astro:assets';
import head from '../../assets/manifesto/head.png';

const text =
  'Мне важно не просто закрыть задачу и сдать макет. Я отношусь к чужому продукту так, будто он мой: стараюсь понять, что за ним стоит, и помочь ему стать сильнее, а не просто красивее.';
const words = text.split(' ');
---

<section class="manifesto" aria-label="Мой подход" data-manifesto>
  <div class="manifesto__head">
    <Image
      src={head}
      widths={[130, 200, 260, 400]}
      sizes="(min-width: 1920px) 200px, (min-width: 1024px) 133px, 130px"
      alt=""
      loading="lazy"
      decoding="async"
      data-mascot-poster="head"
    />
  </div>
  <p class="manifesto__text">
    {
      words.map((word, i) => (
        <>
          <span class="manifesto__word" style={`--i:${i}`} data-part>
            {word}
          </span>{' '}
        </>
      ))
    }
  </p>
</section>

<style>
  .manifesto {
    position: relative;
    z-index: 2; /* над фиксированным 3D-холстом: тело маскота уходит за текст */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    min-height: 100svh;
    padding: 80px 13px;
    overflow-x: clip; /* раздвинутые головой строки не дают горизонтальной прокрутки */
    color: var(--color-text);
  }

  .manifesto__head {
    width: 130px;
    transition: opacity 0.6s ease;
  }

  /* 3D готов — на месте постера будет 3D-голова */
  :global([data-stage][data-mascot='ready']) ~ .manifesto .manifesto__head {
    opacity: 0;
  }

  .manifesto__head :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .manifesto__text {
    max-width: 367px;
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.04em;
    text-align: center;
    perspective: 900px;
  }

  .manifesto__word {
    display: inline-block;
  }

  /* 1024–1440: ноутбучный макет × (ширина / 1440) */
  @media (min-width: 1024px) {
    .manifesto {
      padding-inline: calc(79.5 * 100vw / 1440);
    }

    .manifesto__head {
      width: calc(133 * 100vw / 1440);
    }

    .manifesto__text {
      max-width: none;
      font-size: calc(58 * 100vw / 1440);
    }
  }

  /* 1440–1920: плавно к десктопному */
  @media (min-width: 1440px) {
    .manifesto {
      padding-inline: calc(79.5px - 39.5 * (100vw - 1440px) / 480);
    }

    .manifesto__head {
      width: calc(133px + 67 * (100vw - 1440px) / 480);
    }

    .manifesto__text {
      font-size: calc(58px + 6 * (100vw - 1440px) / 480);
    }
  }

  @media (min-width: 1920px) {
    .manifesto {
      padding-inline: 40px;
    }

    .manifesto__head {
      width: 200px;
    }

    .manifesto__text {
      font-size: 64px;
    }
  }

  /* ---------- переворот слов при появлении (data-reveal ставит Stage.vue) ---------- */
  /* скрытие мгновенное (секция в этот момент за экраном), анимация — только на появление */
  .manifesto[data-reveal] .manifesto__word {
    opacity: 0;
    transform: translateY(0.35em) rotateX(-90deg);
    transform-origin: 50% 100%;
  }

  .manifesto[data-reveal='in'] .manifesto__word {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s ease,
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i) * 28ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .manifesto[data-reveal] .manifesto__word {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
