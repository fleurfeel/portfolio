---
// Сцена «первый экран → избранные проекты → обо мне»: экраны лежат слоями в одном sticky-экране,
// между ними — переходы «туман» (маскот переезжает между экранами), между переходами скролл листает кейсы.
// «Обо мне» на телефоне выше экрана: после сцены sticky-экран уезжает вверх вместе с ней,
// а «хвост» под сценой даёт место её продолжению (высоту ставит Stage.vue).
// Без JS (до гидрации Stage.vue) экраны стоят друг под другом обычным потоком.
import { readdirSync, statSync } from 'node:fs';
import { join } from 'node:path';
import { projects } from '../../data/projects';
import { STAGE, aboutStart } from '../../lib/stage/math';
import About from '../about/About.astro';
import Hero from '../hero/Hero.astro';
import Projects from '../projects/Projects.astro';
import Stage from './Stage.vue';

const n = projects.length;

// Размеры моделей для полоски прелоадера (fetch не всегда отдаёт Content-Length при сжатии).
const modelsDir = join(process.cwd(), 'public', 'models');
const modelSizes = Object.fromEntries(
  readdirSync(modelsDir)
    .filter((f) => f.endsWith('.glb'))
    .map((f) => [`/models/${f}`, statSync(join(modelsDir, f)).size]),
);
const end = aboutStart(n) + STAGE.about;
const snaps = [0, ...projects.map((_, i) => STAGE.transition + STAGE.step * i), end];
---

<div
  class="stage"
  data-stage
  style={`--transition:${STAGE.transition};--end:${end}`}
>
  <div class="stage__pin" data-pin>
    <div class="stage__layer" data-layer="hero"><Hero /></div>
    <div class="stage__layer" data-layer="projects"><Projects /></div>
    <div class="stage__layer stage__layer--about" data-layer="about"><About /></div>
    <Stage client:idle modelSizes={modelSizes} />
  </div>

  <!-- цели ссылок меню: места в скролле, где открыт первый кейс и «Обо мне» -->
  <div id="projects" class="stage__anchor" style={`--flow:1;--fx:${STAGE.transition}`}></div>
  <div id="about" class="stage__anchor" style={`--flow:2;--fx:${end}`}></div>
  {snaps.map((at) => <div class="stage__snap" style={`--at:${at}`} />)}
</div>
<div class="stage-tail" data-stage-tail></div>

<style>
  .stage {
    position: relative;
  }

  .stage__anchor {
    position: absolute;
    top: calc(100svh * var(--flow));
  }

  .stage__snap {
    display: none;
  }

  /* ---------- сцена включена (Stage.vue гидрирован) ---------- */
  .stage[data-fx] {
    height: calc(100svh * (1 + var(--end)));
  }

  /* по вертикали не обрезаем: «Обо мне» на телефоне продолжается ниже экрана */
  .stage[data-fx] .stage__pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow-x: clip;
  }

  .stage[data-fx] .stage__layer {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  /* скрытый слой не ловит клики, но остаётся доступен с клавиатуры (фокус прокручивает к нему) */
  .stage[data-fx] .stage__layer[data-hidden] :global(a),
  .stage[data-fx] .stage__layer[data-hidden] :global(button) {
    pointer-events: none;
  }

  .stage[data-fx] .stage__layer--about {
    bottom: auto;
    min-height: 100%;
  }

  .stage[data-fx] .stage__anchor {
    top: calc(100svh * var(--fx));
  }

  .stage[data-fx] .stage__snap {
    position: absolute;
    top: calc(100svh * var(--at));
    display: block;
    width: 1px;
    height: 1px;
    scroll-snap-align: start;
  }

  :global(:root:has(.stage[data-fx])) {
    scroll-snap-type: y proximity;
  }
</style>
