---
// Сцена «первый экран → избранные проекты»: оба экрана лежат слоями в одном sticky-экране,
// между ними — пролёт камеры сквозь маскота, дальше скролл листает кейсы.
// Без JS (до гидрации Stage.vue) экраны стоят друг под другом обычным потоком.
import { projects } from '../../data/projects';
import { STAGE } from '../../lib/stage/math';
import Hero from '../hero/Hero.astro';
import Projects from '../projects/Projects.astro';
import Stage from './Stage.vue';

const n = projects.length;
const snaps = [0, ...projects.map((_, i) => STAGE.transition + STAGE.step * i)];
---

<div
  class="stage"
  data-stage
  style={`--n:${n};--transition:${STAGE.transition};--step:${STAGE.step};--hold:${STAGE.hold}`}
>
  <div class="stage__pin" data-pin>
    <div class="stage__layer" data-layer="hero"><Hero /></div>
    <div class="stage__layer" data-layer="projects"><Projects /></div>
    <Stage client:idle />
  </div>

  <!-- цель ссылок «Проекты» / «Смотреть портфолио»: место в скролле, где открыт первый кейс -->
  <div id="projects" class="stage__anchor"></div>
  {snaps.map((at) => <div class="stage__snap" style={`--at:${at}`} />)}
</div>

<style>
  .stage {
    position: relative;
  }

  .stage__anchor {
    position: absolute;
    top: 100svh;
  }

  .stage__snap {
    display: none;
  }

  /* ---------- сцена включена (Stage.vue гидрирован) ---------- */
  .stage[data-fx] {
    height: calc(100svh * (1 + var(--transition) + var(--step) * (var(--n) - 1) + var(--hold)));
  }

  .stage[data-fx] .stage__pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
  }

  .stage[data-fx] .stage__layer {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  /* скрытый слой не ловит клики, но остаётся доступен с клавиатуры (фокус прокручивает к нему) */
  .stage[data-fx] .stage__layer[data-hidden] :global(a),
  .stage[data-fx] .stage__layer[data-hidden] :global(button) {
    pointer-events: none;
  }

  .stage[data-fx] .stage__anchor {
    top: calc(100svh * var(--transition));
  }

  .stage[data-fx] .stage__snap {
    position: absolute;
    top: calc(100svh * var(--at));
    display: block;
    width: 1px;
    height: 1px;
    scroll-snap-align: start;
  }

  :global(:root:has(.stage[data-fx])) {
    scroll-snap-type: y proximity;
  }
</style>
