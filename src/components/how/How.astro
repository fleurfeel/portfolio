---
// «Как я работаю». Макеты Figma: Laptop 1440 (492:362), Desktop 1920 (492:444); мобильного макета нет.
// Ноутбук и десктоп: закреплённый экран — заголовок, шапки колонок и голова стоят по центру, а скролл
// на месте листает пары шагов: текущая резкая, соседние в тумане (CSS scroll-driven animations);
// после остановки прокрутки Stage.vue доводит её ровно до ближайшего шага. Голова — между колонками,
// на уровне текущего шага. Без поддержки или при reduced motion — обычные две колонки.
// Телефон: вместо двух колонок — переключатель «для заказчика / для работодателя» на радиокнопках, без JS;
// слева от шагов — шкала прогресса: по ней едет маленькая голова (sticky), линия заполняется по скроллу.
// Голова — постер: 3D-голова из манифеста перетекает сюда.
import { Image } from 'astro:assets';
import head from '../../assets/manifesto/head.png';
import { tracks } from '../../data/how';

const n = tracks[0]!.steps.length;
---

<section class="how" id="how" aria-labelledby="how-title" data-how style={`--n:${n}`}>
  <div class="how__pin">
  <!-- слова по отдельности: пролетая сюда, 3D-голова раздвигает их (Stage.vue, data-part) -->
  <h2 id="how-title" class="how__title">
    {'Как я работаю'.split(' ').map((word) => <><span class="how__word" data-part>{word}</span>{' '}</>)}
  </h2>

  <div class="how__body">
    <div class="how__head">
      <Image
        src={head}
        widths={[130, 200, 260, 400]}
        sizes="(min-width: 1920px) 200px, (min-width: 1024px) 133px, 130px"
        alt=""
        loading="lazy"
        decoding="async"
        data-mascot-poster="how-head"
      />
    </div>

    <!-- переключатель для телефона: колонки показывает/прячет CSS через :has(:checked), без JS -->
    <div class="how__switch" role="radiogroup" aria-label="Для кого">
      {
        tracks.map((track, i) => (
          <label class="how__option" for={`how-${track.id}`}>
            <input class="sr-only" type="radio" name="how-track" id={`how-${track.id}`} value={track.id} checked={i === 0} />
            {track.tag}
          </label>
        ))
      }
    </div>


    {
      tracks.map((track, side) => (
        <div class={`how__track how__track--${track.id}`} style={`--side:${side}`}>
          <div class="how__track-head">
            <span class="how__tag">{track.tag}</span>
            <h3 class="how__track-title">{track.title}</h3>
          </div>
          <div class="how__window">
            <div class="how__rail" aria-hidden="true">
              <span class="how__rail-fill" />
              <span class="how__rail-head">
                <Image src={head} widths={[40, 80, 120]} sizes="40px" alt="" loading="lazy" decoding="async" />
              </span>
            </div>
            <ol class="how__steps">
              {track.steps.map((step, i) => (
                <li class="how__step" style={`--row:${i + 2}`}>
                  <h4 class="how__step-title">{step.title}</h4>
                  <p class="how__step-text">{step.text}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      ))
    }
  </div>
  </div>

</section>

<style>
  .how {
    position: relative;
    overflow-x: clip; /* раздвинутый головой заголовок не даёт горизонтальной прокрутки; sticky не ломает */
    z-index: 2; /* над фиксированным 3D-холстом */
    color: var(--color-text);
    text-align: center;
  }

  .how__word {
    display: inline-block;
    transition: translate 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .how__title {
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .how__head {
    justify-self: center;
    transition: opacity 0.6s ease;
  }

  .how__head :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* 3D готов — на месте постера будет 3D-голова */
  :global([data-stage][data-mascot='ready']) ~ .how .how__head {
    opacity: 0;
  }

  .how__track-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .how__tag {
    padding: 4px 12px;
    border-radius: 60px;
    background: var(--color-accent);
    color: var(--color-bg);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.04em;
  }

  .how__track-title,
  .how__step-title {
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.04em;
  }

  .how__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .how__step-text {
    line-height: 1.3;
  }

  /* ---------- телефон (< 1024): переключатель и одна колонка ---------- */
  @media (max-width: 1023.98px) {
    .how {
      padding: 80px 20px;
    }

    .how__title {
      font-size: 32px;
      font-weight: 700;
    }

    .how__switch {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px;
      align-self: stretch;
      margin: 16px 0 24px;
      padding: 4px;
      border: 1px solid var(--color-accent);
      border-radius: 60px;
    }

    .how__option {
      padding: 10px 8px;
      border-radius: 60px;
      color: var(--color-accent);
      font-size: 16px;
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: -0.04em;
      cursor: pointer;
      transition:
        background-color 0.2s ease,
        color 0.2s ease;
    }

    .how__option:has(:checked) {
      background: var(--color-accent);
      color: var(--color-bg);
    }

    .how__option:has(:focus-visible) {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }

    .how__body {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-top: 24px;
    }

    .how__head {
      width: 130px;
    }

    .how:has(#how-client:checked) .how__track--employer,
    .how:has(#how-employer:checked) .how__track--client {
      display: none;
    }

    .how__tag {
      display: none; /* роль показывает переключатель */
    }

    .how__track-title {
      font-size: 24px;
    }

    .how__steps {
      display: flex;
      flex-direction: column;
      gap: 40px;
    }

    .how__step {
      align-items: flex-start;
      gap: 8px;
      text-align: left;
    }

    .how__step-title {
      font-size: 20px;
    }

    .how__step-text {
      font-size: 16px;
    }

    /* шкала прогресса слева от шагов */
    .how__window {
      position: relative;
      margin-top: 32px;
      padding-left: 48px;
      text-align: left;
    }

    .how__rail {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 19px;
      width: 2px;
      border-radius: 2px;
      background: color-mix(in srgb, var(--color-secondary) 22%, var(--color-bg));
    }

    .how__rail-fill {
      position: absolute;
      inset: 0;
      border-radius: 2px;
      background: var(--color-accent);
      transform: scaleY(0);
      transform-origin: top;
    }

    /* голова держится по центру экрана, пока список шагов проезжает мимо, и упирается в его края */
    .how__rail-head {
      position: sticky;
      top: calc(50svh - 18px);
      display: block;
      width: 36px;
      margin-left: -17px;
    }

    .how__rail-head :global(img) {
      display: block;
      width: 100%;
      height: auto;
    }

    @supports (animation-timeline: view()) {
      .how__window {
        /* таймлайн через переменную: иначе минификатор склеит его с шортхендом animation */
        --rail-timeline: view();
      }

      /* линия заполняется от «начало списка в центре экрана» до «конец списка в центре экрана» */
      .how__rail-fill {
        animation: how-rail linear both;
        animation-timeline: var(--rail-timeline);
        animation-range: cover 50svh cover calc(100% - 50svh);
      }

      @media (prefers-reduced-motion: no-preference) {
        .how__step {
          --step-timeline: view();

          animation: how-step-soft linear both;
          animation-timeline: var(--step-timeline);
          animation-range: cover 0% cover 100%;
        }
      }
    }
  }

  @keyframes how-rail {
    to {
      transform: scaleY(1);
    }
  }

  /* лёгкий туман: шаги вдали от центра читаются, но текущий заметно ярче */
  @keyframes how-step-soft {
    0%,
    100% {
      opacity: 0.45;
      filter: blur(1.5px);
    }

    38%,
    62% {
      opacity: 1;
      filter: blur(0);
    }
  }

  /* ---------- ноутбук и десктоп (≥ 1024): две колонки, ряды выровнены ---------- */
  @media (min-width: 1024px) {
    /* 1024–1440: ноутбучный макет × (ширина / 1440) */
    .how {
      --k: calc(100vw / 1440);
      --pad-x: calc(60 * var(--k));
      --pad-top: calc(120 * var(--k));
      --title-fs: calc(58 * var(--k));
      --title-gap: calc(141 * var(--k));
      --col-w: calc(536 * var(--k));
      --head-w: calc(133 * var(--k));
      --track-title-fs: calc(32 * var(--k));
      --tag-fs: max(14px, calc(20 * var(--k)));
      --row-gap: calc(81 * var(--k));
      --first-gap: calc(69 * var(--k));
      --step-title-fs: max(16px, calc(24 * var(--k)));
      --step-text-fs: max(14px, calc(16 * var(--k)));
      --text-w: calc(416 * var(--k));

      padding: var(--pad-top) var(--pad-x) calc(var(--pad-top) * 1.5);
    }

    .how__title {
      font-size: var(--title-fs);
    }

    .how__switch,
    .how__rail {
      display: none;
    }

    .how__body {
      display: grid;
      grid-template-columns: var(--col-w) 1fr var(--col-w);
      row-gap: var(--row-gap);
      margin-top: var(--title-gap);
    }

    /* колонки «растворяются» в сетку: заголовки — в 1-й ряд, шаги — по своим рядам */
    .how__track,
    .how__window,
    .how__steps {
      display: contents;
    }

    .how__track-head {
      grid-row: 1;
      grid-column: calc(1 + var(--side) * 2);
      align-self: start;
      margin-bottom: calc(var(--first-gap) - var(--row-gap));
    }

    /* голова выше заголовков колонок и выступает над ними: в высоту ряда её не считаем */
    .how__head {
      grid-row: 1;
      grid-column: 2;
      align-self: center;
      width: var(--head-w);
      margin-block: -200px;
    }

    .how__step {
      grid-row: var(--row);
      grid-column: calc(1 + var(--side) * 2);
    }

    .how__tag {
      font-size: var(--tag-fs);
    }

    .how__track-title {
      font-size: var(--track-title-fs);
    }

    .how__step-title {
      font-size: var(--step-title-fs);
    }

    .how__step-text {
      max-width: var(--text-w);
      font-size: var(--step-text-fs);
    }

    /* скролл мягко доводит ряд до центра экрана */
    .how__step {
      scroll-snap-align: center;
    }
  }

  /* 1440–1920: плавно к десктопному макету */
  @media (min-width: 1440px) {
    .how {
      --pad-x: calc(60px - 20 * (100vw - 1440px) / 480);
      --pad-top: calc(120px - 8 * (100vw - 1440px) / 480);
      --title-fs: calc(58px + 6 * (100vw - 1440px) / 480);
      --title-gap: 141px;
      --col-w: calc(536px + 217 * (100vw - 1440px) / 480);
      --head-w: calc(133px + 67 * (100vw - 1440px) / 480);
      --track-title-fs: calc(32px + 4 * (100vw - 1440px) / 480);
      --tag-fs: 20px;
      --row-gap: calc(81px - 1 * (100vw - 1440px) / 480);
      --first-gap: calc(69px + 11 * (100vw - 1440px) / 480);
      --step-title-fs: calc(24px + 4 * (100vw - 1440px) / 480);
      --step-text-fs: calc(16px + 4 * (100vw - 1440px) / 480);
      --text-w: calc(416px + 337 * (100vw - 1440px) / 480);
    }
  }

  @media (min-width: 1920px) {
    .how {
      --pad-x: 40px;
      --pad-top: 112px;
      --title-fs: 64px;
      --col-w: 753px;
      --head-w: 200px;
      --track-title-fs: 36px;
      --row-gap: 80px;
      --first-gap: 80px;
      --step-title-fs: 28px;
      --step-text-fs: 20px;
      --text-w: 753px;
    }
  }

  /* ---------- фокус по центру экрана: выше и ниже — туман (ноутбук и десктоп) ---------- */
  @supports (animation-timeline: view()) {
    @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
      .how {
        /* таймлайн через переменную: иначе минификатор склеит его с шортхендом animation и браузер отбросит */
        --how-timeline: view();
      }

      .how__step,
      .how__track-head {
        animation: how-focus linear both;
        animation-timeline: var(--how-timeline);
        animation-range: cover 0% cover 100%;
      }
    }
  }

  /* ---------- закреплённый экран: шаги листаются на месте (ноутбук и десктоп) ---------- */
  @supports (animation-timeline: view()) {
    @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
      .how {
        /* таймлайн через переменную: иначе минификатор склеит его с шортхендом animation */
        --how-tl: --how;
        --pitch: calc(205 * var(--k));
        --window: min(calc(var(--pitch) * 1.5), calc(100svh - 300 * var(--k)));
        --pin-first-gap: calc(12 * var(--k));
        --pin-title-gap: calc(56 * var(--k));

        height: calc(100svh * (1 + (var(--n) - 1) * 0.6));
        padding: 0;
        view-timeline-name: --how;
      }

      .how__pin {
        position: sticky;
        top: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        height: 100svh;
        padding-inline: var(--pad-x);
      }

      .how__body {
        grid-template-rows: auto var(--window);
        row-gap: var(--pin-first-gap);
        margin-top: var(--pin-title-gap);
      }

      /* голова — между колонками, на уровне текущего шага */
      .how__head {
        grid-row: 2;
        align-self: center;
        margin-block: 0;
      }

      .how__track-head {
        margin-bottom: 0;
        animation: none;
      }

      /* окно колонки: видна текущая пара шагов и края соседних, края тают в фон */
      .how__window {
        display: block;
        grid-row: 2;
        grid-column: calc(1 + var(--side) * 2);
        height: var(--window);
        overflow: clip;
        mask-image: linear-gradient(to bottom, transparent, black 22%, black 78%, transparent);
      }

      .how__steps {
        position: relative;
        display: block;
        height: calc(var(--pitch) * var(--n));
        transform: translateY(calc(var(--window) / 2 - var(--pitch) / 2));
        animation: how-scroll linear both;
        animation-timeline: var(--how-tl);
        animation-range: contain 0% contain 100%;
      }

      .how__step {
        position: absolute;
        top: calc((var(--row) - 2) * var(--pitch));
        right: 0;
        left: 0;
        justify-content: center;
        height: var(--pitch);
        scroll-snap-align: none;
        animation: how-step-focus linear both;
        animation-timeline: var(--how-tl);
        animation-range: contain calc((var(--row) - 3) * 100% / (var(--n) - 1)) contain calc((var(--row) - 1) * 100% / (var(--n) - 1));
      }

    }

    @media (min-width: 1440px) and (prefers-reduced-motion: no-preference) {
      .how {
        --pitch: calc(205px + 25 * (100vw - 1440px) / 480);
        --window: min(calc(var(--pitch) * 1.5), calc(100svh - 300px));
        --pin-title-gap: 56px;
        --pin-first-gap: 12px;
      }
    }
  }

  @keyframes how-scroll {
    to {
      transform: translateY(calc(var(--window) / 2 - var(--pitch) / 2 - var(--pitch) * (var(--n) - 1)));
    }
  }

  @keyframes how-step-focus {
    0%,
    100% {
      opacity: 0.15;
      filter: blur(6px);
    }

    50% {
      opacity: 1;
      filter: blur(0);
    }
  }

  @keyframes how-focus {
    0%,
    100% {
      opacity: 0.15;
      filter: blur(6px);
    }

    32%,
    68% {
      opacity: 1;
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .how__head,
    .how__option {
      transition: none;
    }
  }
</style>
