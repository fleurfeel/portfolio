---
// Футер: тёмная полоса, снизу по центру выглядывает голова маскота. Слева копирайт, справа документы по 152-ФЗ.
// Голова выезжает снизу, пока футер появляется на экране (CSS scroll-driven animation; без поддержки
// или при reduced motion — сразу на месте), и чуть приподнимается при наведении.
import { Image } from 'astro:assets';
import head from '../../assets/manifesto/head.png';

const year = new Date().getFullYear();
const docs = [
  { href: '/privacy', label: 'Политика обработки персональных данных' },
  { href: '/consent', label: 'Согласие на обработку данных' },
];
---

<footer class="footer">
  <p class="footer__copy">© {year} Пашковский Руслан</p>

  <nav class="footer__docs" aria-label="Документы">
    {docs.map((doc) => <a href={doc.href}>{doc.label}</a>)}
  </nav>

  <div class="footer__head" aria-hidden="true">
    <Image src={head} widths={[240, 360, 480, 720]} sizes="(min-width: 1024px) 360px, 240px" alt="" loading="lazy" decoding="async" />
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 2; /* над фиксированным 3D-холстом */
    display: grid;
    overflow: hidden;
    background: var(--color-text);
    color: color-mix(in srgb, var(--color-bg) 75%, transparent);
    font-size: 14px;
    line-height: 1.3;
  }

  .footer__docs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .footer a {
    transition: color 0.2s ease;
  }

  .footer a:hover {
    color: var(--color-bg);
  }

  .footer a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  /* окно показывает верх картинки: кудри и глаза, остальное за краем футера */
  .footer__head {
    grid-area: head;
    justify-self: center;
    align-self: end;
    width: var(--head-w);
    height: calc(var(--head-w) * 0.7);
    overflow: hidden;
  }

  .footer__head :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: translate 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (hover: hover) {
    .footer__head:hover :global(img) {
      translate: 0 -6%;
    }
  }

  /* ---------- телефон (< 1024): текст над головой, по центру ---------- */
  @media (max-width: 1023.98px) {
    .footer {
      --head-w: 240px;

      grid-template-areas: 'docs' 'copy' 'head';
      justify-items: center;
      gap: 16px;
      padding: 48px 20px 0;
      text-align: center;
    }

    .footer__docs {
      grid-area: docs;
      flex-direction: column;
      align-items: center;
    }

    .footer__copy {
      grid-area: copy;
    }

    .footer__head {
      margin-top: 16px;
    }
  }

  /* ---------- ноутбук и десктоп: копирайт и документы по краям, голова по центру ---------- */
  @media (min-width: 1024px) {
    .footer {
      --head-w: 360px;

      grid-template-columns: 1fr auto 1fr;
      grid-template-areas: 'copy head docs';
      align-items: end;
      min-height: 300px;
      padding: 0 calc(55 * 100vw / 1440);
    }

    .footer__copy {
      grid-area: copy;
      padding-bottom: 28px;
    }

    .footer__docs {
      grid-area: docs;
      justify-content: flex-end;
      padding-bottom: 28px;
    }
  }

  @media (min-width: 1920px) {
    .footer {
      padding-inline: 55px;
      font-size: 16px;
    }
  }

  /* голова выезжает снизу, пока футер заезжает на экран (таймлайн — через переменную: минификатор иначе ломает animation-timeline) */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* таймлайн — по самому футеру: его низ совпадает с концом страницы, так что анимация доигрывает до конца */
      .footer {
        view-timeline-name: --footer;
      }

      .footer__head :global(img) {
        --peek-tl: --footer;

        animation: footer-peek linear both;
        animation-timeline: var(--peek-tl);
        animation-range: entry 0% entry 100%;
      }
    }
  }

  @keyframes footer-peek {
    from {
      transform: translateY(60%);
    }

    to {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer a,
    .footer__head :global(img) {
      transition: none;
    }
  }
</style>
