---
// Страница кейса в духе студийных кейсов (Bigly, Clay, Locomotive): огромный заголовок, вводный текст крупно, факты
// строкой, обложка во всю ширину — в неё вырастает карточка кейса (морф, см. global.css). Разделы разбора: слева
// метка «(01) Задача», справа первый абзац крупным вводным текстом, остальные — обычным; экраны во всю ширину.
// В конце — приглашение обсудить проект (форма заявки, остров LeadForm) и крупная ссылка на следующий кейс.
// Экраны проявляются по скроллу (scroll-driven, только transform и opacity) и открываются во весь экран
// (остров CaseLightbox, кнопки data-zoom). Кейс без разбора — шапка, приглашение и следующий кейс.
import { Image } from 'astro:assets';
import ArrowRightLong from '../../assets/icons/arrow-right-long.svg';
import { coverTransitionName, projectUrl, projects } from '../../data/projects';
import Footer from '../../components/footer/Footer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatCounter } from '../../lib/stage/math';
import { caseStudies } from '../../data/cases';
import CaseLightbox from '../../components/case/CaseLightbox.vue';
import LeadForm from '../../components/services/LeadForm.vue';
import { services } from '../../data/services';

export function getStaticPaths() {
  return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, index } }));
}

const { project, index } = Astro.props;
const next = projects[(index + 1) % projects.length]!;
const study = caseStudies[project.slug];
const sizes: Record<string, string> = {
  wide: '(min-width: 1600px) 1488px, 100vw',
  page: '(min-width: 840px) 760px, 100vw',
  pair: '(min-width: 1600px) 740px, (min-width: 720px) 50vw, 100vw',
  trio: '(min-width: 1600px) 490px, (min-width: 720px) 33vw, 100vw',
  phones: '(min-width: 720px) 280px, 70vw',
};
const num = (i: number) => `(${String(i + 1).padStart(2, '0')})`;
const natural = (src: { width: number; height: number }, scale = 1) => ({ width: Math.round(src.width / scale), height: Math.round(src.height / scale) });
---

<BaseLayout title={`${project.title} — кейс | Пашковский Руслан`} description={project.summary}>
  <main class="case">
    <nav class="case__nav" aria-label="Навигация по кейсам">
      <a href="/">На главную</a>
      <a href="/projects">Все проекты</a>
    </nav>

    <header class="case__hero">
      <p class="case__counter">{formatCounter(index, projects.length)}</p>
      <h1 class="case__title">{project.title}</h1>
      <div class="case__intro">
        <p class="case__label">(Коротко)</p>
        <div class="case__intro-body">
          <p class="case__summary">{project.summary}</p>
          {
            study && (
              <dl class="case__facts">
                {study.facts.map((fact) => (
                  <div>
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))}
              </dl>
            )
          }
        </div>
      </div>
    </header>

    <div class="case__image" style={`view-transition-name:${coverTransitionName(project)}`}>
      <Image src={project.cover} widths={[600, 1000, 1400, 1920]} sizes="(min-width: 1600px) 1488px, 100vw" alt={`Первый экран ${project.title}`} loading="eager" />
    </div>

    {
      study?.sections.map((section, i) => {
        const [lead, ...rest] = section.text;
        return (
          <section class="case__section">
            <h2 class="case__section-label">
              <span class="case__section-num" aria-hidden="true">
                {num(i)}
              </span>
              {section.title}
            </h2>
            <div class="case__section-body">
              {lead && <p class="case__lead">{lead}</p>}
              {rest.length > 0 && (
                <div class="case__section-text">
                  {rest.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              )}
            </div>
            {section.media?.map((media) => (
              <div class:list={['case__media', `case__media--${media.layout}`]}>
                {media.images.map((image, k) => {
                  const n = natural(image.src, image.scale);
                  return (
                    <figure class="case__shot" style={`--k:${k};--natural:${n.width}px`}>
                      <button
                        class:list={['case__shot-frame', image.bare && 'case__shot-frame--bare']}
                        type="button"
                        data-zoom
                        data-natural={`${n.width}x${n.height}`}
                        aria-label={`Открыть во весь экран: ${image.alt}`}
                      >
                        <Image
                          src={image.src}
                          widths={[400, 700, 1000, 1440, image.src.width].filter((w) => w <= image.src.width)}
                          sizes={sizes[media.layout]}
                          alt={image.alt}
                          loading="lazy"
                          decoding="async"
                        />
                      </button>
                      {image.caption && <figcaption>{image.caption}</figcaption>}
                    </figure>
                  );
                })}
              </div>
            ))}
          </section>
        );
      })
    }

    <section class="case__outro" aria-labelledby="case-outro-title">
      <h2 id="case-outro-title" class="case__outro-title">Нужен продукт, который так же работает на бизнес?</h2>
      <button class="case__cta" type="button" data-lead="">Обсудить проект</button>
    </section>

    <a class="case__next" href={projectUrl(next)}>
      <span class="case__next-label">Следующий проект</span>
      <span class="case__next-title">{next.title}</span>
      <span class="case__next-cover" aria-hidden="true">
        <Image src={next.cover} widths={[400, 700]} sizes="(min-width: 1024px) 360px, 90vw" alt="" loading="lazy" decoding="async" />
      </span>
      <span class="case__next-arrow" aria-hidden="true"><ArrowRightLong /></span>
    </a>
  </main>
  <Footer />
  {study && <CaseLightbox client:idle />}
  <LeadForm client:idle services={services.map((s) => s.title)} />
</BaseLayout>

<style>
  .case {
    display: flex;
    flex-direction: column;
    max-width: 1600px;
    margin: 0 auto;
    padding: 32px clamp(20px, 4vw, 56px) 96px;
    color: var(--color-text);
  }

  .case__nav {
    display: flex;
    justify-content: space-between;
    font-weight: var(--font-weight-text);
  }

  .case a:focus-visible,
  .case button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  /* ---------- шапка ---------- */
  .case__hero {
    margin-top: clamp(48px, 7vw, 112px);
  }

  .case__counter {
    color: var(--color-accent);
    font-weight: var(--font-weight-text);
  }

  .case__title {
    margin-top: 12px;
    font-size: clamp(52px, 10vw, 168px);
    font-weight: var(--font-weight-heading);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .case__intro {
    display: grid;
    gap: 16px 32px;
    margin-top: clamp(32px, 4vw, 64px);
  }

  .case__label,
  .case__section-num,
  .case__next-label {
    color: var(--color-secondary);
    font-size: 15px;
    font-weight: var(--font-weight-text);
    line-height: 1.3;
  }

  /* вводный текст и первые абзацы разделов — крупно, как в студийных кейсах */
  .case__summary,
  .case__lead {
    max-width: 30em;
    font-size: clamp(22px, 2.3vw, 36px);
    font-weight: var(--font-weight-text);
    line-height: 1.27;
  }

  .case__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 24px 32px;
    margin-top: clamp(32px, 4vw, 56px);
    padding-top: 20px;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);
  }

  .case__facts dt {
    color: var(--color-secondary);
    font-size: 14px;
    line-height: 1.2;
  }

  .case__facts dd {
    margin-top: 6px;
    font-size: 17px;
    line-height: 1.3;
  }

  .case__image {
    margin-top: clamp(40px, 6vw, 96px);
    overflow: hidden;
    view-transition-class: case-cover;
    border-radius: clamp(18px, 2.5vw, 36px);
    background: color-mix(in srgb, var(--color-secondary) 18%, var(--color-bg));
  }

  .case__image :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* текст шапки всплывает по очереди, пока обложка встаёт на место */
  @media (prefers-reduced-motion: no-preference) {
    .case__counter,
    .case__title,
    .case__intro {
      animation: case-rise 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    }

    .case__counter {
      animation-delay: 0.25s;
    }

    .case__title {
      animation-delay: 0.32s;
    }

    .case__intro {
      animation-delay: 0.42s;
    }
  }

  @keyframes case-rise {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }

  /* ---------- разделы ---------- */
  .case__section {
    display: grid;
    gap: 20px 32px;
    margin-top: clamp(96px, 12vw, 200px);
  }

  .case__section-label {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 15px;
    font-weight: var(--font-weight-text);
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .case__section-num {
    letter-spacing: 0;
  }

  .case__section-text {
    display: grid;
    gap: 14px;
    max-width: 40em;
    margin-top: clamp(20px, 2vw, 32px);
    color: var(--color-secondary);
    font-size: clamp(17px, 1.25vw, 20px);
    line-height: 1.45;
  }

  .case__media {
    display: grid;
    gap: clamp(12px, 1.5vw, 24px);
    grid-column: 1 / -1;
    justify-items: center;
    margin-top: clamp(24px, 3vw, 48px);
  }

  /* экран целиком и не крупнее, чем в макете (--natural): мелкие блоки не растягиваются и не мылятся */
  .case__shot {
    width: 100%;
    max-width: var(--natural);
  }

  .case__shot figcaption {
    margin-top: 10px;
    color: var(--color-secondary);
    font-size: 14px;
    line-height: 1.3;
  }

  /* экран лежит на белой подложке со скруглением, как карточки сайта */
  .case__shot-frame {
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    cursor: zoom-in;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    border: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent);
    border-radius: clamp(14px, 2vw, 28px);
    background: var(--color-surface);
  }

  @media (hover: hover) {
    .case__shot-frame:hover {
      transform: scale(1.01);
    }
  }

  .case__shot-frame--bare {
    border: 0;
    border-radius: 0;
    background: none;
  }

  .case__shot-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* длинная страница целиком: уже, чтобы не занимала несколько экранов */
  .case__media--page .case__shot {
    max-width: min(var(--natural), 760px);
  }

  /* телефоны: листаются вбок, если не помещаются */
  .case__media--phones {
    grid-auto-flow: column;
    grid-auto-columns: min(70vw, 280px);
    justify-content: start;
    overflow-x: auto;
    padding-bottom: 8px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .case__media--phones::-webkit-scrollbar {
    display: none;
  }

  .case__media--phones .case__shot {
    scroll-snap-align: start;
  }

  /* длинная страница на телефоне листается прямо в рамке, как на экране телефона: картинка целиком, без обрезки */
  .case__media--phones .case__shot-frame {
    max-height: min(640px, 80svh);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    border-radius: 28px;
  }

  @media (min-width: 720px) {
    .case__media--pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    .case__media--trio {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .case__media--phones {
      justify-content: center;
      gap: 20px;
    }
  }

  /* ---------- финал: заявка и следующий кейс ---------- */
  .case__outro {
    display: grid;
    justify-items: center;
    gap: clamp(24px, 3vw, 40px);
    margin-top: clamp(120px, 14vw, 240px);
    text-align: center;
  }

  .case__outro-title {
    max-width: 14em;
    font-size: clamp(36px, 5.5vw, 88px);
    font-weight: var(--font-weight-heading);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .case__cta {
    padding: 18px 36px;
    border-radius: 42px;
    background: var(--color-accent);
    color: var(--color-surface);
    font: inherit;
    font-size: 17px;
    font-weight: var(--font-weight-text);
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @media (hover: hover) {
    .case__cta:hover {
      transform: scale(1.04);
    }
  }

  .case__next {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'label label'
      'title arrow'
      'cover cover';
    align-items: center;
    gap: 12px 24px;
    margin-top: clamp(96px, 12vw, 200px);
    padding-top: 24px;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);
  }

  .case__next-label {
    grid-area: label;
  }

  .case__next-title {
    grid-area: title;
    font-size: clamp(40px, 7vw, 120px);
    font-weight: var(--font-weight-heading);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .case__next-cover {
    grid-area: cover;
    display: block;
    width: min(100%, 360px);
    margin-top: 8px;
    overflow: hidden;
    border-radius: 20px;
  }

  .case__next-cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .case__next-arrow {
    grid-area: arrow;
    display: block;
    width: clamp(40px, 5vw, 80px);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .case__next-arrow :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (hover: hover) {
    .case__next:hover .case__next-arrow {
      transform: translateX(12px);
    }

    .case__next:hover .case__next-cover :global(img) {
      transform: scale(1.04);
    }
  }

  /* ---------- ноутбук и десктоп: метки слева, текст справа, как в студийных кейсах ---------- */
  @media (min-width: 1024px) {
    .case__intro,
    .case__section {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    }

    .case__section-label {
      position: sticky;
      top: 24px;
      align-self: start;
    }

    .case__next {
      grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr);
      grid-template-areas:
        'label title cover'
        '. arrow cover';
      align-items: end;
    }

    .case__next-label {
      align-self: start;
    }

    .case__next-cover {
      justify-self: end;
      margin-top: 0;
    }
  }

  /* экраны и текст разделов всплывают, пока заезжают на экран; соседние экраны — с небольшим отставанием (--k).
     Таймлайн — через переменную: минификатор иначе ломает animation-timeline */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .case__shot,
      .case__section-label,
      .case__section-body,
      .case__outro,
      .case__next {
        --rise-tl: view();

        animation: case-shot linear both;
        animation-timeline: var(--rise-tl);
        animation-range: entry calc(var(--k, 0) * 6%) entry calc(55% + var(--k, 0) * 6%);
      }
    }
  }

  @keyframes case-shot {
    from {
      opacity: 0;
      transform: translateY(48px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case__shot-frame,
    .case__cta,
    .case__next-cover :global(img),
    .case__next-arrow {
      transition: none;
    }
  }
</style>
