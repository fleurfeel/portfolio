---
// Все проекты. Два вида, переключатель на радиокнопках без JS (:has(:checked)):
// «Список» — типографский индекс в духе свежих портфолио с Awwwards (Roman Jean-Elie, Locomotive): огромные названия
// строками; на ноутбуке и десктопе при наведении остальные строки гаснут, название сдвигается, а справа проявляется
// обложка. На телефоне обложка стоит прямо в строке.
// «Сетка» — крупные обложки в две колонки со сдвигом второй колонки вниз (редакционная сетка).
// Морф в шапку кейса (view transitions, см. global.css): у обложки в списке имя перехода появляется только при
// наведении — иначе на странице было бы два элемента с одним именем; в сетке и на телефоне имена постоянные.
// Появление — только transform и opacity, при reduced motion всё сразу на местах.
import { Image } from 'astro:assets';
import ArrowRightLong from '../../assets/icons/arrow-right-long.svg';
import { coverTransitionName, projectUrl, projects } from '../../data/projects';
import Footer from '../../components/footer/Footer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const num = (i: number) => String(i + 1).padStart(2, '0');
---

<BaseLayout title="Все проекты | Пашковский Руслан" description="Кейсы продуктового дизайнера Руслана Пашковского.">
  <main class="work">
    <nav class="work__nav" aria-label="Навигация">
      <a href="/">На главную</a>
      <a href="/#services">Обсудить проект</a>
    </nav>

    <header class="work__head">
      <h1 class="work__title">
        Работы<sup class="work__count">({String(projects.length).padStart(2, '0')})</sup>
      </h1>
      <p class="work__lead">Продукты, которые я спроектировал: платформы, сервисы с ИИ, магазины и лендинги — от исследования до готового интерфейса.</p>

      <fieldset class="work__view">
        <legend class="sr-only">Вид списка</legend>
        <label><input type="radio" name="view" value="list" checked /> <span>Список</span></label>
        <label><input type="radio" name="view" value="grid" /> <span>Сетка</span></label>
      </fieldset>
    </header>

    <!-- список -->
    <ol class="work__list" aria-label="Проекты списком">
      {
        projects.map((project, i) => (
          <li class="work__item" style={`--i:${i};--vt:${coverTransitionName(project)}`}>
            <a class="work__row" href={projectUrl(project)}>
              <span class="work__num">({num(i)})</span>
              <span class="work__name">{project.title}</span>
              <span class="work__tags">{project.tags.join(' · ')}</span>
              <span class="work__arrow" aria-hidden="true">
                <ArrowRightLong />
              </span>
              <span class="work__thumb" aria-hidden="true">
                <Image src={project.cover} widths={[400, 700, 1000]} sizes="(min-width: 1024px) 36vw, 100vw" alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <!-- сетка -->
    <ul class="work__grid" aria-label="Проекты сеткой">
      {
        projects.map((project, i) => (
          <li class="work__card" style={`--i:${i}`}>
            <a href={projectUrl(project)}>
              <span class="work__cover" style={`view-transition-name:${coverTransitionName(project)}`}>
                <Image src={project.cover} widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 46vw, 100vw" alt="" loading="lazy" decoding="async" />
              </span>
              <span class="work__card-meta">
                <span class="work__num">({num(i)})</span>
                <span class="work__card-name">{project.title}</span>
                <span class="work__tags">{project.tags.join(' · ')}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
  <Footer />
</BaseLayout>

<style>
  .work {
    max-width: 1600px;
    margin: 0 auto;
    padding: 32px clamp(20px, 4vw, 56px) 120px;
    color: var(--color-text);
  }

  .work__nav {
    display: flex;
    justify-content: space-between;
    font-weight: var(--font-weight-text);
  }

  .work a:focus-visible,
  .work input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  /* ---------- шапка ---------- */
  .work__head {
    display: grid;
    gap: 20px 32px;
    margin-top: clamp(48px, 7vw, 112px);
    margin-bottom: clamp(40px, 6vw, 96px);
  }

  .work__title {
    font-size: clamp(64px, 14vw, 240px);
    font-weight: var(--font-weight-heading);
    line-height: 0.85;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .work__count {
    margin-left: 0.08em;
    color: var(--color-accent);
    font-size: 0.22em;
    letter-spacing: 0;
    vertical-align: top;
  }

  .work__lead {
    max-width: 30em;
    color: var(--color-secondary);
    font-size: clamp(18px, 1.6vw, 24px);
    line-height: 1.35;
  }

  .work__view {
    display: flex;
    gap: 6px;
    justify-self: start;
    padding: 4px;
    border-radius: 40px;
    background: color-mix(in srgb, var(--color-text) 7%, transparent);
  }

  .work__view label {
    cursor: pointer;
  }

  .work__view input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .work__view span {
    display: block;
    padding: 10px 20px;
    border-radius: 40px;
    font-size: 15px;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .work__view input:checked + span {
    background: var(--color-text);
    color: var(--color-surface);
  }

  .work__num {
    color: var(--color-secondary);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }

  .work__tags {
    color: var(--color-secondary);
    font-size: 15px;
    line-height: 1.3;
  }

  /* ---------- переключение вида ---------- */
  .work:has(input[value='list']:checked) .work__grid,
  .work:has(input[value='grid']:checked) .work__list {
    display: none;
  }

  /* ---------- список ---------- */
  .work__list {
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 16%, transparent);
  }

  .work__row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'num name arrow'
      '. tags arrow'
      'thumb thumb thumb';
    align-items: baseline;
    gap: 6px 16px;
    padding: 22px 0 26px;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 16%, transparent);
  }

  .work__row .work__num {
    grid-area: num;
  }

  .work__name {
    grid-area: name;
    font-size: clamp(34px, 6.2vw, 112px);
    font-weight: var(--font-weight-heading);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    overflow-wrap: break-word;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .work__row .work__tags {
    grid-area: tags;
  }

  .work__arrow {
    grid-area: arrow;
    align-self: center;
    width: clamp(28px, 3vw, 48px);
    transition:
      transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.4s ease;
  }

  .work__arrow :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* телефон и планшет: обложка прямо в строке */
  .work__thumb {
    grid-area: thumb;
    display: block;
    margin-top: 16px;
    overflow: hidden;
    border-radius: 18px;
    background: color-mix(in srgb, var(--color-secondary) 18%, var(--color-bg));
    aspect-ratio: 16 / 10;
    view-transition-name: var(--vt);
    view-transition-class: case-cover;
  }

  .work__thumb :global(img),
  .work__cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }

  /* ноутбук и десктоп с мышью: строки — только типографика, обложка появляется справа при наведении */
  @media (min-width: 1024px) and (hover: hover) {
    .work__row {
      grid-template-columns: 80px minmax(0, 1fr) auto;
      grid-template-areas:
        'num name arrow'
        '. tags arrow';
      padding: 28px 0 32px;
    }

    .work__name {
      max-width: 62%;
    }

    .work__arrow {
      opacity: 0;
      transform: translateX(-24px);
    }

    /* обложка висит справа по центру экрана и проявляется у строки под курсором */
    .work__thumb {
      position: fixed;
      z-index: 3;
      top: 50%;
      right: clamp(20px, 4vw, 56px);
      width: 36vw;
      max-width: 620px;
      margin: 0;
      border-radius: 24px;
      opacity: 0;
      transform: translateY(-46%) scale(0.92) rotate(-2deg);
      transition:
        opacity 0.35s ease,
        transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
      pointer-events: none;
      /* имя перехода — только у обложки под курсором (см. шапку файла) */
      view-transition-name: none;
    }

    .work__row:hover .work__thumb,
    .work__row:focus-visible .work__thumb {
      opacity: 1;
      transform: translateY(-50%);
      view-transition-name: var(--vt);
    }

    .work__row:hover .work__name,
    .work__row:focus-visible .work__name {
      transform: translateX(24px);
    }

    .work__row:hover .work__arrow,
    .work__row:focus-visible .work__arrow {
      opacity: 1;
      transform: none;
    }

    /* остальные строки гаснут */
    .work__item {
      transition: opacity 0.35s ease;
    }

    .work__list:has(.work__row:hover) .work__item:not(:has(.work__row:hover)) {
      opacity: 0.28;
    }
  }

  /* ---------- сетка ---------- */
  .work__grid {
    display: grid;
    gap: clamp(40px, 5vw, 72px) clamp(16px, 2vw, 32px);
  }

  .work__card a {
    display: grid;
    gap: 16px;
  }

  .work__cover {
    display: block;
    overflow: hidden;
    border-radius: clamp(18px, 2vw, 28px);
    background: color-mix(in srgb, var(--color-secondary) 18%, var(--color-bg));
    aspect-ratio: 16 / 10;
    view-transition-class: case-cover;
  }

  .work__cover :global(img) {
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .work__card-meta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 4px 14px;
  }

  .work__card-name {
    font-size: clamp(28px, 3vw, 48px);
    font-weight: var(--font-weight-heading);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .work__card-meta .work__tags {
    grid-column: 2;
  }

  @media (hover: hover) {
    .work__card a:hover .work__cover :global(img) {
      transform: scale(1.04);
    }
  }

  @media (min-width: 720px) {
    .work__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* вторая колонка сдвинута вниз — редакционный ритм */
    .work__card:nth-child(2n) {
      margin-top: clamp(80px, 10vw, 180px);
    }
  }

  /* ---------- шапка: переключатель справа от заголовка ---------- */
  @media (min-width: 1024px) {
    .work__head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .work__lead {
      grid-column: 1;
    }

    .work__view {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: end;
    }
  }

  /* ---------- появление ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .work__title,
    .work__lead,
    .work__view {
      animation: work-rise 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    }

    .work__lead {
      animation-delay: 0.1s;
    }

    .work__view {
      animation-delay: 0.15s;
    }

    /* строки и карточки поднимаются волной. В строке анимируется содержимое, а не сама строка: трансформация
       предка сделала бы его рамкой для fixed-обложки, и та во время появления вставала бы не на своё место */
    .work__row > :not(.work__thumb),
    .work__card {
      animation: work-rise 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
      animation-delay: calc(0.2s + var(--i) * 0.07s);
    }
  }

  @keyframes work-rise {
    from {
      opacity: 0;
      transform: translateY(48px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work__name,
    .work__arrow,
    .work__thumb,
    .work__item,
    .work__view span,
    .work__cover :global(img) {
      transition: none;
    }
  }
</style>
